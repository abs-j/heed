{
  "manifest_version": 3,
  "name": "Heed",
  "version": "2.5.0",
  "description": "Decide what deserves your attention on X. Thumbs up or down teaches it; slop, rage bait and topics you want less of fold away.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://openrouter.ai/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "lib.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Heed"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
